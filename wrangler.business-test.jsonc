{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "you-in-music-business-test",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "you-in-music-orders-test"
    }
  ]
}
